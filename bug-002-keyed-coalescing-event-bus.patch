+class CoalescingEventBusTest(unittest.IsolatedAsyncioTestCase):
+    @staticmethod
+    def _store() -> RollingStateStore:
+        return RollingStateStore(
+            retention_seconds=60,
+            max_events_per_key=8,
+            boot_id="boot-a",
+        )
+
+    @staticmethod
+    def _event(key: str, sequence: int) -> MarketEvent:
+        return MarketEvent(
+            source="feed",
+            key=key,
+            kind="quote",
+            value=sequence,
+            summary={"sequence": sequence},
+            received_realtime_ns=sequence,
+            received_monotonic_ns=sequence,
+            chain_position=sequence,
+            event_id=f"{key}:{sequence}",
+            source_epoch=1,
+            boot_id="boot-a",
+        )
+
+    async def _wait_for_backpressure(self, bus: CoalescingEventBus) -> None:
+        for _ in range(20):
+            if bus.snapshot()["publisher_backpressure_waits"]:
+                return
+            await asyncio.sleep(0)
+        self.fail("publisher did not enter bounded backpressure")
+
+    async def test_hot_key_coalesces_to_latest_without_growing_queue(self) -> None:
+        bus = CoalescingEventBus(self._store(), capacity=4)
+
+        for sequence in range(1, 1_001):
+            await bus.publish(self._event("A", sequence))
+
+        snapshot = bus.snapshot()
+        self.assertEqual(snapshot["accepted_events"], 1_000)
+        self.assertEqual(snapshot["pending_keys"], 1)
+        self.assertEqual(snapshot["queued"], 1)
+        self.assertEqual(snapshot["queue_high_watermark"], 1)
+        self.assertEqual(snapshot["coalesced_updates"], 999)
+        self.assertEqual(snapshot["dropped_events"], 0)
+
+        delivered = await bus.next_event()
+        self.assertEqual(delivered.key, "A")
+        self.assertEqual(delivered.value, 1_000)
+        self.assertEqual(bus.snapshot()["pending_keys"], 0)
+
+    async def test_distinct_key_waits_for_capacity_instead_of_evicting(self) -> None:
+        bus = CoalescingEventBus(self._store(), capacity=2)
+        await bus.publish(self._event("A", 1))
+        await bus.publish(self._event("B", 1))
+
+        blocked = asyncio.create_task(bus.publish(self._event("C", 1)))
+        await self._wait_for_backpressure(bus)
+        self.assertFalse(blocked.done())
+        self.assertEqual(bus.snapshot()["pending_keys"], 2)
+        self.assertEqual(bus.snapshot()["dropped_events"], 0)
+
+        first = await bus.next_event()
+        self.assertEqual(first.key, "A")
+        await asyncio.wait_for(blocked, timeout=0.5)
+
+        second = await bus.next_event()
+        third = await bus.next_event()
+        self.assertEqual([second.key, third.key], ["B", "C"])
+        self.assertEqual(bus.snapshot()["publisher_backpressure_waits"], 1)
+        self.assertEqual(bus.snapshot()["queue_high_watermark"], 2)
+
+    async def test_hot_key_cannot_evict_single_cold_key(self) -> None:
+        bus = CoalescingEventBus(self._store(), capacity=2)
+        await bus.publish(self._event("B", 1))
+
+        for sequence in range(1, 1_001):
+            await bus.publish(self._event("A", sequence))
+
+        snapshot = bus.snapshot()
+        self.assertEqual(snapshot["pending_keys"], 2)
+        self.assertEqual(snapshot["dropped_events"], 0)
+        self.assertEqual(snapshot["coalesced_updates"], 999)
+
+        cold = await bus.next_event()
+        hot = await bus.next_event()
+        self.assertEqual(cold.key, "B")
+        self.assertEqual(hot.key, "A")
+        self.assertEqual(hot.value, 1_000)
+
+    async def test_rejected_state_event_never_enters_pending_bus(self) -> None:
+        bus = CoalescingEventBus(self._store(), capacity=2)
+        accepted = self._event("A", 2)
+        rejected = self._event("A", 1)
+
+        await bus.publish(accepted)
+        await bus.publish(rejected)
+
+        snapshot = bus.snapshot()
+        self.assertEqual(snapshot["accepted_events"], 1)
+        self.assertEqual(snapshot["rejected_state_events"], 1)
+        self.assertEqual(snapshot["pending_keys"], 1)
+        self.assertEqual((await bus.next_event()).value, 2)
+
+        with self.assertRaises(TimeoutError):
+            await asyncio.wait_for(bus.next_event(), timeout=0.01)
+
+    async def test_close_wakes_publisher_waiting_for_distinct_key_capacity(self) -> None:
+        bus = CoalescingEventBus(self._store(), capacity=1)
+        await bus.publish(self._event("A", 1))
+
+        blocked = asyncio.create_task(bus.publish(self._event("B", 1)))
+        await self._wait_for_backpressure(bus)
+        self.assertFalse(blocked.done())
+
+        await bus.close()
+        await asyncio.wait_for(blocked, timeout=0.5)
+        snapshot = bus.snapshot()
+        self.assertTrue(snapshot["closed"])
+        self.assertEqual(snapshot["pending_keys"], 1)
+        self.assertEqual(snapshot["dropped_events"], 0)
+
