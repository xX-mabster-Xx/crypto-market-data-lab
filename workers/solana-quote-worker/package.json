{
  "name": "solana-quote-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only local quote worker for the unified Solana market scanner",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "drift-perp": "tsx src/driftPerp.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "run": "tsx src/worker.ts",
    "benchmark": "node --import tsx --no-warnings ../../tools/benchmark-amm-simulation.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@drift-labs/sdk": "2.156.0",
    "@meteora-ag/dlmm": "1.9.14",
    "@orca-so/common-sdk": "0.7.1",
    "@orca-so/whirlpools-sdk": "0.22.0",
    "@raydium-io/raydium-sdk-v2": "0.2.63-alpha",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.5"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
